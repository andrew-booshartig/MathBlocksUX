{
  "name": "mathblocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "calculator": "tauri dev --config src-tauri/tauri.calculator.conf.json",
    "build:engine": "cd sidecar && .venv/bin/python -m PyInstaller --noconfirm --clean --onedir --name engine --distpath dist --workpath build/pyinstaller --specpath build --collect-submodules mathcore --exclude-module tkinter --exclude-module PyInstaller --exclude-module pytest --log-level WARN engine.py"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@replit/codemirror-vim": "6.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.12.0",
    "dockview": "8.5.1",
    "dockview-react": "8.5.1",
    "katex": "^0.18.9",
    "marked": "18.1.1",
    "mathlive": "^0.110.0",
    "plotly.js-dist-min": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-katex": "^3.1.0",
    "react-plotly.js": "^4.1.0",
    "smol-toml": "^1.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/plotly.js": "^3.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-katex": "^3.0.4",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
