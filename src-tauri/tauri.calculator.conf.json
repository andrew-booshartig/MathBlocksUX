{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixLab Calculator",
  "identifier": "com.andrewboos.matrixlab.calculator",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1430 --strictPort",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "title": "MatrixLab Calculator",
        "url": "calculator.html",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 520,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 }
      }
    ]
  }
}
